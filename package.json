{
  "name": "quotify-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Quotify (quote) API on Cloudflare Workers, backed by a GitHub-hosted JSON dataset with KV lazy caching.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:ids": "node scripts/normalize-ids.mjs",
    "data:ids:check": "node scripts/normalize-ids.mjs --check",
    "validate:data": "vitest run tests/data.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  }
}
